# backend_api/.env.example
# Copie para .env e ajuste. Nunca commitar o .env real.

# --- Django ---
DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1
# URL base do frontend — usada em links de e-mail (reset de senha, etc.)
FRONTEND_URL=http://localhost:5173

# --- Banco de dados ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pgba
DB_USER=pgba
DB_PASSWORD=pgba
DB_HOST=db
DB_PORT=5432

# --- Celery / Redis ---
REDIS_URL=redis://redis:6379/0
# Senha do Redis (opcional em dev, recomendado em produção).
# Se definida, o docker-compose passa --requirepass automaticamente.
# Atualize REDIS_URL para redis://:senha@redis:6379/0
REDIS_PASSWORD=

# --- LGPD / Criptografia ---
# Mesma chave usada por core.utils.lgpd (campos sensíveis: CPF, etc) e por
# harness.crypto (credenciais de IA armazenadas em AIProviderCredential).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Salt usado para gerar o hash do IP em core.models.ConsentRecord.hash_ip
# (nunca armazenar IP em texto puro — Art. 12 LGPD)
LGPD_IP_SALT=

# --- CORS (produção) ---
CORS_ALLOWED_ORIGINS=https://seusite.com
SECURE_SSL_REDIRECT=True

# --- 🧠 RAG / IA local-first ---
EMBEDDING_PROVIDER=ollama          # ollama | openai
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://ollama:11434  # Docker: http://ollama:11434 | Local (fora do Docker): http://localhost:11434
OLLAMA_CHAT_MODEL=llama3

# --- 🧭 Harness de IA: credenciais dos provedores (orchestration + ingestion) ---
# Estas variáveis são só o FALLBACK de desenvolvimento. Em produção, prefira
# configurar via Django admin ou `python manage.py configure_ai_provider`
# (fica criptografado no banco, sobrescrevível por tenant, sem redeploy).
CHAT_PROVIDER=ollama               # ollama | openai | anthropic | groq | openrouter
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
GROQ_API_KEY=
GROQ_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# --- 🧭 Orquestração (Q&A sobre dado estruturado) ---
AI_MODEL_FAST=qwen2.5:14b
AI_MODEL_STANDARD=mistral-nemo:14b
AI_MODEL_REPORT=deepseek-r1:14b

# --- 📓 Obsidian ---
# Caminho da pasta do SEU vault no Windows (não dentro do container —
# o docker-compose monta esse caminho pra dentro do container em
# /vaults, fixo; é ESSE caminho fixo que você usa depois nos comandos
# do backend, nunca o valor daqui). Exemplo real:
# OBSIDIAN_VAULT_PATH=C:\Users\seu-usuario\Documents\MeuVaultObsidian
OBSIDIAN_VAULT_PATH=C:\Users\seu-usuario\Documents\MeuVaultObsidian

# --- Templates de projeto (agency.create_project) ---
# Só precisa definir isso rodando FORA do Docker (ex: pytest local sem
# container). Dentro do Docker, o docker-compose já monta o volume certo
# em /app/project-templates (default desta variável) — nunca precisa
# mexer aqui pra rodar via `docker compose up`.
# PROJECT_TEMPLATES_PATH=../frontend/project-templates

# --- Pagamentos (Asaas) — quando o módulo `payments` for implementado ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- 🕷️ Scraping — Google Maps (container gosom/google-maps-scraper) ---
# Inicie com: docker compose --profile scraping up -d
# Mais info: docs/scraping.md
GMAPS_SCRAPER_URL=http://localhost:8080
GMAPS_SCRAPER_API_KEY=
SCRAPING_TIMEOUT=120
