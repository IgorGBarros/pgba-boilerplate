# backend_api/.env.example
# Copie para .env e ajuste. Nunca commitar o .env real.

# --- Django ---
DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pgba
DB_USER=pgba
DB_PASSWORD=pgba
DB_HOST=db
DB_PORT=5432

# --- Celery / Redis ---
REDIS_URL=redis://redis:6379/0

# --- LGPD / Criptografia ---
# Mesma chave usada por core.utils.lgpd (campos sensíveis: CPF, etc) e por
# harness.crypto (credenciais de IA armazenadas em AIProviderCredential).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Salt usado para gerar o hash do IP em core.models.ConsentRecord.hash_ip
# (nunca armazenar IP em texto puro — Art. 12 LGPD)
LGPD_IP_SALT=

# --- CORS (produção) ---
CORS_ALLOWED_ORIGINS=https://seusite.com
SECURE_SSL_REDIRECT=True

# --- 🧠 RAG / IA local-first ---
EMBEDDING_PROVIDER=ollama          # ollama | openai
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3

# --- 🧭 Harness de IA: credenciais dos provedores (orchestration + ingestion) ---
# Estas variáveis são só o FALLBACK de desenvolvimento. Em produção, prefira
# configurar via Django admin ou `python manage.py configure_ai_provider`
# (fica criptografado no banco, sobrescrevível por tenant, sem redeploy).
CHAT_PROVIDER=ollama               # ollama | openai | anthropic | groq | openrouter
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GROQ_API_KEY=
GROQ_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# --- 🧭 Orquestração (Q&A sobre dado estruturado) ---
AI_MODEL_FAST=qwen2.5:14b
AI_MODEL_STANDARD=mistral-nemo:14b
AI_MODEL_REPORT=deepseek-r1:14b

# --- 📓 Obsidian ---
# Caminho do vault dentro do container (ver volume `/vaults` no docker-compose).
OBSIDIAN_VAULT_PATH=/vaults/meu-vault

# --- Pagamentos (Asaas) — quando o módulo `payments` for implementado ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
