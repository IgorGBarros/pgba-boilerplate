# frontend/.env.example
VITE_API_URL=http://localhost:8000

# Necessário só para `npm run generate` (geração automática de páginas via
# harness do backend). Gere com POST /api/v1/users/token/ (ver docs/API.md) e nunca
# comite o .env real — este token dá acesso de escrita a /api/v1/harness/generate/.
PGBA_ACCESS_TOKEN=

# Protege os endpoints que rodam comandos na sua máquina (terminal, git,
# Claude Code). Use o MESMO valor nos dois (o do devserver e o do navegador).
DEVSERVER_SECRET=
VITE_DEVSERVER_SECRET=

# Claude Code local (tarefas do setor Desenvolvimento — devserver/lib/claudeCode.mjs)
# Caminho do executável, se `claude` não estiver no PATH:
# CLAUDE_CODE_BIN=claude
# Argumentos do modo "Rodar aqui" (sem ninguém pra aprovar, o que não for liberado é negado):
# CLAUDE_CODE_ARGS=--permission-mode acceptEdits
# Linux: terminal usado pelo modo "Abrir no terminal" (padrão: o primeiro que existir)
# CLAUDE_CODE_TERMINAL=gnome-terminal --
