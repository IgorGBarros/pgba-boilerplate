# frontend/.env.example
VITE_API_URL=http://localhost:8000

# Necessário só para `npm run generate` (geração automática de páginas via
# harness do backend). Gere com POST /api/v1/users/token/ (ver docs/API.md) e nunca
# comite o .env real — este token dá acesso de escrita a /api/v1/harness/generate/.
PGBA_ACCESS_TOKEN=
